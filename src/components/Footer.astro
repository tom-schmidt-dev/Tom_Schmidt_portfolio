---
import { Github, Linkedin, Mail } from 'lucide-astro';

const currentYear = new Date().getFullYear();
---

<footer class="border-t border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 text-zinc-600 dark:text-zinc-400 py-12">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
      
      <!-- Brand & Spec Summary -->
      <div class="md:col-span-2 space-y-3">
        <div class="font-mono font-bold text-zinc-900 dark:text-zinc-100 text-sm tracking-tight">
          tom-schmidt.dev
        </div>
        <p class="text-xs text-zinc-600 dark:text-zinc-400 max-w-sm leading-relaxed">
          Tom Schmidt <br>
          Informatikstudent an der HTW Berlin
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-xs font-mono font-semibold uppercase tracking-wider text-zinc-900 dark:text-zinc-200 mb-3">
          // Navigation
        </h4>
        <ul class="space-y-2 text-xs font-mono">
          <li>
            <a href="/#about" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
              &gt; Profil
            </a>
          </li>
          <li>
            <a href="/#skills" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
              &gt; Fähigkeiten
            </a>
          </li>
          <li>
            <a href="/#projects" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
              &gt; KI-Projekte
            </a>
          </li>
          <li>
            <a href="/#architecture" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
              &gt; Architektur
            </a>
          </li>
          <li>
            <a href="/#contact" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
              &gt; Kontakt
            </a>
          </li>
        </ul>
      </div>

      <!-- Connect -->
      <div>
        <h4 class="text-xs font-mono font-semibold uppercase tracking-wider text-zinc-900 dark:text-zinc-200 mb-3">
          // Profile & Links
        </h4>
        <ul class="space-y-2 text-xs font-mono">
          <li>
            <a
              href="https://github.com/tom-schmidt-dev"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors"
            >
              <Github class="w-3.5 h-3.5" />
              <span>GitHub</span>
            </a>
          </li>
          <li>
            <a
              href="https://www.linkedin.com/in/tom-schmidt-dev/"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors"
            >
              <Linkedin class="w-3.5 h-3.5" />
              <span>LinkedIn</span>
            </a>
          </li>
          <li>
            <a
              href="mailto:kontakt@tom-schmidt.dev"
              class="inline-flex items-center gap-1.5 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors"
            >
              <Mail class="w-3.5 h-3.5" />
              <span>kontakt@tom-schmidt.dev</span>
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar mit Rechtstexten & Tech-Stack -->
    <div class="pt-6 border-t border-zinc-200 dark:border-zinc-800 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-zinc-500">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <span>&copy; {currentYear} tom-schmidt.dev</span>
        <span>&middot;</span>
        <a href="/impressum" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
          Impressum
        </a>
        <span>&middot;</span>
        <a href="/datenschutz" class="hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors">
          Datenschutz
        </a>
      </div>

      <div class="flex items-center gap-2">
        <span>ASTRO</span>
        <span>/</span>
        <span>TAILWIND</span>
        <span>/</span>
        <span>DOCKER</span>
      </div>
    </div>
  </div>
</footer>