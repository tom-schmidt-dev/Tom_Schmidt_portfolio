---
import Carousel from './Carousel.astro';
import ProjectCard from './ProjectCard.astro';
import projectsData from '../data/projects.json';

const projects = [
  projectsData[0],
  projectsData[1],
  projectsData[2],
  projectsData[3],
  projectsData[5],
  projectsData[4],

];
---

<section id="projects" class="scroll-mt-24 py-16 md:py-24 border-b border-zinc-200 dark:border-zinc-800 transition-[background-color] duration-150 ease-out hover:bg-zinc-200/70 dark:hover:bg-zinc-800/70">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Symmetrical two-stage structure) -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4 pb-6 border-b border-zinc-200 dark:border-zinc-800">
      <div>
        <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 uppercase tracking-wider mb-2">
          // 03. Erfahrung
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold text-zinc-900 dark:text-zinc-100 tracking-tight">
          Details zu meinen Projekten
        </h2>
        <p class="text-zinc-600 dark:text-zinc-400 text-sm sm:text-base mt-2 max-w-2xl leading-relaxed">
          AI-Engineering, Infrastruktur, Clean Architecture
        </p>
      </div>

      <div class="flex items-center">
        <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400 border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900 px-3 py-1.5">
          <!-- GESAMT: <strong class="text-zinc-900 dark:text-zinc-100">{projectsData.length} PROJEKTE</strong> -->
          STATUS: <strong class="text-red-600 dark:text-red-400">IN ENTWICKLUNG</strong>
        </span>
      </div>
    </div>

    <!-- Project Cards Carousel -->
    <div class="carousel-zoom-wrapper">
      <Carousel id="carousel-projects" ariaLabel="Künstliche Intelligenz und RAG-Systeme" cardHeightCollapsed="23.5rem">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}

        <ProjectCard project={{
          id: "placeholder-projects",
          title: "Konkrete Projekte in Planung",
          category: "Ideensammlung",
          tabs: ["In Planung"],
          isPlaceholder: true,
          tags: ["Simple Notizapp in Kotlin", "App für Lebensmittelverwaltung", "Personal Assistant mit RAG", "HomeAssistant ins HomeLab einbinden"]
        }} />
      </Carousel>
    </div>

  </div>
</section>