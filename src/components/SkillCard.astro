---
import { getTabAbbr } from '../utils/tabs';

export interface SkillItem {
  index?: string;
  title: string;
  tabs?: string[];
  description?: string;
  skills: string[];
  isPlaceholder?: boolean;
}

export interface Props {
  skill: SkillItem;
}

const { skill } = Astro.props;
const isPlaceholder = skill.isPlaceholder || skill.title === '...';
const tabs: string[] = skill.tabs ?? [];
---

{isPlaceholder ? (
  <div
    class="skill-card group relative flex flex-col min-[410px]:flex-row items-stretch border-0 p-0 opacity-50 select-none transition-[height,border-color] duration-200 ease-out min-w-0 shrink-0"
    data-multi-tab={tabs.length > 1 ? "true" : "false"}
  >
    <!-- Tabs -->
    {tabs.length > 0 && (
      <div
        class="card-tabs flex shrink-0 select-none flex-wrap min-[410px]:flex-col gap-1 self-start z-10 -mb-px min-[410px]:mb-0 min-[410px]:-mr-px h-auto"
        data-card-tabs
        onclick="event.stopPropagation()"
      >
        {tabs.map((tab) => {
          const abbr = getTabAbbr(tab);
          return (
            <div
              class="card-tab flex-initial min-w-0 inline-flex items-center justify-center px-2.5 py-1 min-[410px]:py-2.5 min-[410px]:px-1.5 rounded-t-md rounded-b-none min-[410px]:rounded-l-md min-[410px]:rounded-r-none border border-b-0 min-[410px]:border-b min-[410px]:border-r-0 border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 shadow-2xs overflow-hidden"
              style="min-inline-size: 4ch;"
              data-card-tab
            >
              <span class="card-tab-label font-mono text-[11px] sm:text-xs tracking-wider text-zinc-700 dark:text-zinc-300 whitespace-nowrap overflow-hidden text-ellipsis">
                <span class="tab-label-full">{tab}</span>
                <span class="tab-label-short">{abbr}</span>
              </span>
            </div>
          );
        })}
      </div>
    )}

    <!-- Kachel-Inhalt -->
    <div
      class="card-content flex-1 min-w-0 flex flex-col justify-between border border-dashed border-zinc-300 dark:border-zinc-800 bg-zinc-50/40 dark:bg-zinc-950/40 p-5 sm:p-6"
      style="--zone-header-h: 4.5rem;"
    >
      <!-- Zone 1: Titel Platzhalter -->
      <div class="min-h-[var(--zone-header-h)] flex flex-col justify-between pb-2 mb-0 border-b border-zinc-100 dark:border-zinc-800/80">
        <div class="flex items-start justify-between gap-2">
          <h3 class="text-base font-semibold text-zinc-900 dark:text-zinc-100 tracking-tight leading-snug">
            Skills, die ich lernen möchte
          </h3>
        </div>
      </div>

      <!-- Zone 2: Badges / Skills Platzhalter -->
      <div class="py-2.5 border-b border-zinc-100 dark:border-zinc-800/80 flex flex-col justify-start shrink-0">
        {skill.skills && skill.skills.length > 0 ? (
          <div class="flex flex-wrap gap-1.5">
            {skill.skills.map((item) => (
              <span class="font-mono text-xs px-2 py-0.5 border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300">
                {item}
              </span>
            ))}
          </div>
        ) : (
          <p class="text-sm font-mono text-zinc-400 dark:text-zinc-600 leading-relaxed">
            Skills, die ich lernen möchte
          </p>
        )}
      </div>

      <!-- Zone 3: Bottom Status -->
      <div class="flex-1 flex flex-col justify-end pt-2.5 min-h-0">
        <div class="flex items-center justify-between">
          <span class="font-mono text-xs text-zinc-500 dark:text-zinc-400">
            ... oder bereits angefangen habe zu lernen
          </span>
          <span class="font-mono text-xs text-zinc-400 dark:text-zinc-600">
            <!--Linktext unten rechts -->
          </span>
        </div>
      </div>
    </div>
  </div>
) : (
  <div
    class="skill-card group relative flex flex-col min-[410px]:flex-row items-stretch shrink-0 cursor-pointer select-text min-w-0"
    data-expandable-card
    data-expanded="false"
    data-multi-tab={tabs.length > 1 ? "true" : "false"}
    tabindex="0"
    role="button"
    aria-expanded="false"
  >
    <!-- Tabs -->
    {tabs.length > 0 && (
      <div
        class="card-tabs flex shrink-0 select-none flex-wrap min-[410px]:flex-col gap-1 self-start z-10 -mb-px min-[410px]:mb-0 min-[410px]:-mr-px h-auto"
        data-card-tabs
        onclick="event.stopPropagation()"
      >
        {tabs.map((tab) => {
          const abbr = getTabAbbr(tab);
          return (
            <div
              class="card-tab flex-initial min-w-0 inline-flex items-center justify-center px-2.5 py-1 min-[410px]:py-2.5 min-[410px]:px-1.5 rounded-t-md rounded-b-none min-[410px]:rounded-l-md min-[410px]:rounded-r-none border border-b-0 min-[410px]:border-b min-[410px]:border-r-0 border-zinc-300 dark:border-zinc-700 bg-white dark:bg-zinc-900 shadow-2xs overflow-hidden"
              style="min-inline-size: 4ch;"
              data-card-tab
            >
              <span class="card-tab-label font-mono text-[11px] sm:text-xs tracking-wider text-zinc-700 dark:text-zinc-300 whitespace-nowrap overflow-hidden text-ellipsis">
                <span class="tab-label-full">{tab}</span>
                <span class="tab-label-short">{abbr}</span>
              </span>
            </div>
          );
        })}
      </div>
    )}

    <!-- Kachel-Inhalt -->
    <div
      class="card-content flex-1 min-w-0 flex flex-col justify-between border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 p-5 sm:p-6 group-hover:border-zinc-400 dark:group-hover:border-zinc-600 transition-colors duration-200 ease-out"
      style="--zone-header-h: 4.5rem;"
    >
      <!-- Zone 1: Titel -->
      <div class="min-h-[var(--zone-header-h)] flex flex-col justify-between pb-2 mb-0 border-b border-zinc-100 dark:border-zinc-800/80">
        <div class="flex items-start justify-between gap-2">
          <h3 class="text-base font-semibold text-zinc-900 dark:text-zinc-100 tracking-tight leading-snug">
            {skill.title}
          </h3>
        </div>
      </div>

      <!-- Zone 2: Badges mit Skills -->
      <div class="py-2.5 border-b border-zinc-100 dark:border-zinc-800/80 flex flex-col justify-start shrink-0">
        <div class="flex flex-wrap gap-1.5">
          {skill.skills.map((item) => (
            <span class="font-mono text-xs px-2 py-0.5 border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300">
              {item}
            </span>
          ))}
        </div>
      </div>

      <!-- Zone 3: Beschreibung & Expander -->
      <div class="flex-1 flex flex-col justify-between pt-2.5 min-h-0">
        <div data-expand-full class="hidden pr-1 pb-3 mb-2.5">
          <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4">
            {skill.description}
          </p>
        </div>

        <div class="mt-auto shrink-0 pb-1">
          <button
            type="button"
            data-expand-btn
            class="relative overflow-hidden font-mono text-[11px] leading-normal py-1 px-0.5 text-zinc-500 hover:text-zinc-800 dark:text-zinc-400 dark:hover:text-zinc-200 underline underline-offset-2 transition-colors cursor-pointer after:content-[''] after:pointer-events-none after:absolute after:inset-0 after:-translate-y-full group-data-[expanded=true]:after:translate-y-full after:transition-none group-hover:after:translate-y-full group-data-[expanded=true]:group-hover:after:-translate-y-full group-hover:after:transition-transform group-hover:after:duration-[1200ms] group-hover:after:ease-out after:bg-[linear-gradient(180deg,transparent_15%,rgba(24,24,27,0.12)_50%,transparent_85%)] group-data-[expanded=true]:after:bg-[linear-gradient(0deg,transparent_15%,rgba(24,24,27,0.12)_50%,transparent_85%)] dark:after:bg-[linear-gradient(180deg,transparent_15%,rgba(255,255,255,0.22)_50%,transparent_85%)] dark:group-data-[expanded=true]:after:bg-[linear-gradient(0deg,transparent_15%,rgba(255,255,255,0.22)_50%,transparent_85%)]"
          >
            [mehr Info]
          </button>
        </div>
      </div>
    </div>
  </div>
)}