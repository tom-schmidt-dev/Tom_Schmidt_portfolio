---
import Carousel from './Carousel.astro';
import CarouselCluster from './CarouselCluster.astro';
import skillData from '../data/skills.json';

const clusters = [
  {
    groupFlag: "Entwicklung & Architektur",
    skills: [skillData[0], skillData[1]],
  },
  {
    groupFlag: "Künstliche Intelligenz",
    skills: [skillData[2], skillData[3]],
  },
  {
    groupFlag: "Infrastruktur & Backend",
    skills: [skillData[4], skillData[5], skillData[6]],
  },
];
---

<section id="skills" class="scroll-mt-24 py-16 md:py-24 border-b border-zinc-200 dark:border-zinc-800 transition-[background-color] duration-150 ease-out hover:bg-zinc-200/70 dark:hover:bg-zinc-800/70">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-12">
      <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 uppercase tracking-wider mb-2">
        // 02. Technisches Profil
      </div>
      <h2 class="text-3xl sm:text-4xl font-bold text-zinc-900 dark:text-zinc-100 tracking-tight">
        Übersicht meiner Kenntnisse
      </h2>
      <p class="text-zinc-600 dark:text-zinc-400 text-sm sm:text-base mt-2 leading-relaxed">
        Eine Zusammenfassung 
      </p>
    </div>

    <!-- Skill Cards Carousel -->
    <div class="carousel-zoom-wrapper">
      <Carousel id="carousel-skills" ariaLabel="Technische Kenntnisse" cardHeightCollapsed="23.5rem">
        {clusters.map((cluster) => (
          <CarouselCluster groupFlag={cluster.groupFlag}>
            {cluster.skills.map((group) => (
              <div
                class="group border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 p-5 sm:p-6 flex flex-col justify-between hover:border-zinc-400 dark:hover:border-zinc-600 transition-[height,border-color] duration-200 ease-out cursor-pointer select-text w-[260px] max-w-[calc(100cqi-1rem)] min-w-0 sm:min-w-[260px] shrink-0"
                data-expandable-card
                data-expanded="false"
                tabindex="0"
                role="button"
                aria-expanded="false"
                style="--zone-header-h: 4.5rem;"
              >
                <!-- Zone 1: Titel & Index (ohne Header-Kategorie) -->
                <div class="min-h-[var(--zone-header-h)] flex flex-col justify-between pb-2 mb-0 border-b border-zinc-100 dark:border-zinc-800/80">
                  <div class="flex items-start justify-between gap-2">
                    <h3 class="text-base font-semibold text-zinc-900 dark:text-zinc-100 tracking-tight leading-snug">
                      {group.title}
                    </h3>
                  </div>
                </div>

                <!-- Zone 2: Badges mit Skills (dynamische Höhe) -->
                <div class="py-2.5 border-b border-zinc-100 dark:border-zinc-800/80 flex flex-col justify-start shrink-0">
                  <div class="flex flex-wrap gap-1.5">
                    {group.skills.map((skill) => (
                      <span class="font-mono text-xs px-2 py-0.5 border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900 text-zinc-700 dark:text-zinc-300">
                        {skill}
                      </span>
                    ))}
                  </div>
                </div>

                <!-- Zone 3: Beschreibung & Text-Expander (vollständige Höhe ohne Scrollbalken) -->
                <div class="flex-1 flex flex-col justify-between pt-2.5 min-h-0">
                  <div data-expand-full class="hidden pr-1 pb-3 mb-2.5">
                    <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed mb-4">
                      {group.description}
                    </p>
                  </div>

                  <div class="mt-auto shrink-0 pb-1">
                    <button
                      type="button"
                      data-expand-btn
                      class="relative overflow-hidden font-mono text-[11px] leading-normal py-1 px-0.5 text-zinc-500 hover:text-zinc-800 dark:text-zinc-400 dark:hover:text-zinc-200 underline underline-offset-2 transition-colors cursor-pointer after:content-[''] after:pointer-events-none after:absolute after:inset-0 after:-translate-y-full group-data-[expanded=true]:after:translate-y-full after:transition-none group-hover:after:translate-y-full group-data-[expanded=true]:group-hover:after:-translate-y-full group-hover:after:transition-transform group-hover:after:duration-[1200ms] group-hover:after:ease-out after:bg-[linear-gradient(180deg,transparent_15%,rgba(24,24,27,0.12)_50%,transparent_85%)] group-data-[expanded=true]:after:bg-[linear-gradient(0deg,transparent_15%,rgba(24,24,27,0.12)_50%,transparent_85%)] dark:after:bg-[linear-gradient(180deg,transparent_15%,rgba(255,255,255,0.22)_50%,transparent_85%)] dark:group-data-[expanded=true]:after:bg-[linear-gradient(0deg,transparent_15%,rgba(255,255,255,0.22)_50%,transparent_85%)]"
                    >
                      [mehr Info]
                    </button>
                  </div>
                </div>
              </div>
            ))}
          </CarouselCluster>
        ))}
      </Carousel>
    </div>
  </div>
</section>