---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Skills from '../components/Skills.astro';
import Projects from '../components/Projects.astro';
import { presentProjects, presentSkills, presentHero } from '../lib/presenters';
import { Mail, Linkedin, ArrowUpRight } from 'lucide-astro';

// Datenabruf über native Astro Content Layer API
const rawProjects = await getCollection('projects');
const rawSkills = await getCollection('skills');

// Transformation via Pure Presenters
const { projects, placeholderProject } = presentProjects(rawProjects);
const { skills, placeholderSkill } = presentSkills(rawSkills);
const heroProps = presentHero();
---

<BaseLayout
  title="Portfolio | Informatik & KI-Systeme"
  description="Portfolio von Tom Schmidt mit Fokus auf RAG-Systeme, Machine Learning, Backend-Entwicklung und Softwarearchitektur."
>
  <!-- 1. Profil / Hero-Bereich -->
  <Hero {...heroProps} />

  <!-- 2. Technisches Profil & Kenntnisse (Skills) -->
  <Skills skills={skills} placeholderSkill={placeholderSkill} />

  <!-- 3. Künstliche Intelligenz (KI-Sektion) -->
  <Projects projects={projects} placeholderProject={placeholderProject} />

  <!-- 4. Kontakt -->
  <section id="contact" class="scroll-mt-24 py-16 md:py-24 transition-[background-color] duration-150 ease-out hover:bg-zinc-200/70 dark:hover:bg-zinc-800/70">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-28 items-center">
        
        <!-- Links: Text & Status (Spalten 1 bis 5) -->
        <div class="lg:col-span-5 space-y-6">
          <div>
            <div class="text-xs font-mono text-zinc-500 dark:text-zinc-400 uppercase tracking-wider mb-2">
              // 04. Kontakt
            </div>
            <h2 class="text-3xl sm:text-4xl font-bold text-zinc-900 dark:text-zinc-100 tracking-tight">
              Kontakt &amp; Anfragen
            </h2>
            <p class="text-zinc-600 dark:text-zinc-400 text-sm leading-relaxed mt-3">
              Interessiert an einer Zusammenarbeit im Rahmen einer Werkstudententätigkeit, eines Projekts oder einer praxisorientierten Bachelorarbeit? Ich freue mich über Ihre Kontaktaufnahme.
            </p>
          </div>

          <!-- Verfügbarkeits-Indikator -->
          <div class="inline-flex items-center gap-2 px-2.5 py-1.5 border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 font-mono text-xs text-zinc-700 dark:text-zinc-300">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Verfügbar als Werkstudent / Bachelorarbeit</span>
          </div>
        </div>

        <!-- Rechts: Interaktive Kontaktkarte (Spalten 7 bis 12) -->
        <div class="lg:col-span-6 lg:col-start-7">
          <div class="border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 divide-y divide-zinc-200 dark:divide-zinc-800 font-mono text-xs shadow-xs">
            
            <!-- Terminal-Header -->
            <div class="px-4 py-2.5 bg-zinc-50 dark:bg-zinc-900/50 flex items-center justify-between text-[11px]">
              <span class="text-zinc-500 uppercase tracking-wider">Kontakt aufnehmen</span>
              <span class="text-zinc-400 dark:text-zinc-500">Berlin // Vor Ort, Hybrid &amp; Remote</span>
            </div>

            <!-- E-Mail Zeile -->
            <a
              href="mailto:kontakt@tom-schmidt.dev"
              class="group p-4 flex items-center justify-between gap-3 hover:bg-zinc-50 dark:hover:bg-zinc-900/60 transition-colors duration-150"
            >
              <div class="flex items-center gap-3.5 min-w-0">
                <div class="p-2 border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900 text-zinc-600 dark:text-zinc-400 group-hover:text-zinc-900 dark:group-hover:text-zinc-100 transition-colors">
                  <Mail class="w-4 h-4" />
                </div>
                <div class="truncate">
                  <span class="block text-[10px] text-zinc-400 dark:text-zinc-500 uppercase tracking-wider">E-Mail</span>
                  <span class="text-zinc-900 dark:text-zinc-100 group-hover:underline underline-offset-2">
                    kontakt@tom-schmidt.dev
                  </span>
                </div>
              </div>
              <ArrowUpRight class="w-4 h-4 text-zinc-400 group-hover:text-zinc-900 dark:group-hover:text-zinc-100 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform shrink-0" />
            </a>

            <!-- LinkedIn Zeile -->
            <a
              href="https://www.linkedin.com/in/tom-schmidt-dev/"
              target="_blank"
              rel="noopener noreferrer"
              class="group p-4 flex items-center justify-between gap-3 hover:bg-zinc-50 dark:hover:bg-zinc-900/60 transition-colors duration-150"
            >
              <div class="flex items-center gap-3.5 min-w-0">
                <div class="p-2 border border-zinc-200 dark:border-zinc-800 bg-zinc-50 dark:bg-zinc-900 text-zinc-600 dark:text-zinc-400 group-hover:text-zinc-900 dark:group-hover:text-zinc-100 transition-colors">
                  <Linkedin class="w-4 h-4" />
                </div>
                <div class="truncate">
                  <span class="block text-[10px] text-zinc-400 dark:text-zinc-500 uppercase tracking-wider">LinkedIn</span>
                  <span class="text-zinc-900 dark:text-zinc-100 group-hover:underline underline-offset-2">
                    linkedin.com/in/tom-schmidt-dev
                  </span>
                </div>
              </div>
              <ArrowUpRight class="w-4 h-4 text-zinc-400 group-hover:text-zinc-900 dark:group-hover:text-zinc-100 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform shrink-0" />
            </a>

            <!-- Footer-Statuszeile -->
            <div class="px-4 py-2.5 bg-zinc-50/50 dark:bg-zinc-900/20 flex items-center justify-between text-[11px] text-zinc-500">
              <span>Rückmeldung:</span>
              <span class="text-zinc-700 dark:text-zinc-300">in der Regel &lt; 24h</span>
            </div>

          </div>
        </div>

      </div>

    </div>
  </section>
</BaseLayout>